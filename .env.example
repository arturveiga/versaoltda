# Contact recipient.
WORDPRESS_CONTACT_RECIPIENT=arturveiga_@hotmail.com

# Production SMTP. Local Docker overrides these values with Mailpit.
WORDPRESS_SMTP_HOST=smtp.example.com
WORDPRESS_SMTP_PORT=587
WORDPRESS_SMTP_AUTH=true
WORDPRESS_SMTP_ENCRYPTION=tls
WORDPRESS_SMTP_USERNAME=
WORDPRESS_SMTP_PASSWORD=
WORDPRESS_SMTP_FROM_EMAIL=
WORDPRESS_SMTP_FROM_NAME=Versão LTDA
